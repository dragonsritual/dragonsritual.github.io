---
import SiteLayout from "../layouts/SiteLayout.astro";
import LaunchHeader from "../components/LaunchHeader.astro";
---
<SiteLayout title="Writer Room — DRAGON" description="Private writer desk inside DragonsRitual.">
  <LaunchHeader />
  <main class="writer-room">
    <header class="writer-room__mast"><div><span class="wr-kicker">DRAGON / PRIVATE DESK</span><h1>WRITER<br/>ROOM</h1></div><div class="writer-room__identity"><span data-author-name>WRITER</span><button type="button" data-signout>SIGN OUT</button></div></header>
    <nav class="writer-room__nav"><button class="is-active" data-view="desk">THE DESK</button><button data-view="drafts">MANUSCRIPTS</button><button data-view="submitted">WITH EDITOR</button><button data-view="published">PUBLISHED</button></nav>
    <section class="writer-room__loading" data-loading>OPENING THE ROOM</section>
    <section class="writer-room__workspace" data-workspace hidden>
      <aside class="writer-room__side"><span class="wr-kicker">MANUSCRIPT</span><div class="writer-room__status"><span>STATUS</span><strong data-status>DRAFT</strong></div><label><span>GENRE</span><select data-genre><option>FANTASY</option><option>HORROR</option><option>SCI-FI</option><option>WEIRD FICTION</option><option>OTHER</option></select></label><div class="writer-room__metric"><span>WORDS</span><strong data-words>0</strong></div><div class="writer-room__metric"><span>READ</span><strong data-read>0 MIN</strong></div><div class="writer-room__metric"><span>FILE</span><strong data-save-state>NEW</strong></div><button class="wr-secondary" type="button" data-new>NEW MANUSCRIPT</button></aside>
      <article class="writer-editor"><input class="writer-editor__title" data-title placeholder="Untitled manuscript"/><input class="writer-editor__deck" data-deck placeholder="A short subtitle or hook — optional"/><div class="writer-editor__rule"></div><textarea class="writer-editor__body" data-body placeholder="Begin here…"></textarea><footer class="writer-editor__actions"><div><button class="wr-secondary" data-save>SAVE DRAFT</button><button class="wr-secondary" data-preview>PREVIEW</button></div><button class="wr-primary" data-submit-editor>SEND TO EDITOR</button></footer><p class="wr-message" data-room-message></p></article>
    </section>
    <section class="writer-library" data-library hidden><header><span class="wr-kicker">YOUR WORK</span><h2 data-library-title>Manuscripts</h2></header><div class="writer-library__list" data-library-list></div></section>
    <dialog class="writer-preview" data-preview-dialog><button class="writer-preview__close" data-close-preview>CLOSE</button><span class="wr-kicker" data-preview-genre>FICTION</span><h1 data-preview-title>Untitled</h1><p class="writer-preview__deck" data-preview-deck></p><div class="writer-preview__byline">BY <span data-preview-author></span> / DRAGON</div><div class="writer-preview__body" data-preview-body></div></dialog>
  </main>
  <script>
    import { getSupabaseBrowserClient } from '../lib/supabaseBrowser';
    const supabase=getSupabaseBrowserClient(); const {data:{session}}=await supabase.auth.getSession(); if(!session)location.href='/join/'; const user=session?.user;
    const $=s=>document.querySelector(s), workspace=$('[data-workspace]'),library=$('[data-library]'),title=$('[data-title]'),deck=$('[data-deck]'),body=$('[data-body]'),genre=$('[data-genre]'),words=$('[data-words]'),read=$('[data-read]'),status=$('[data-status]'),saveState=$('[data-save-state]'),message=$('[data-room-message]');
    let currentId=null,currentStatus='draft',dirty=false; const author=user?.user_metadata?.display_name||user?.email?.split('@')[0]||'Writer'; $('[data-author-name]').textContent=author.toUpperCase();
    const say=(t,b=false)=>{message.textContent=t;message.classList.toggle('is-error',b)}; const count=()=>{const n=body.value.trim()?body.value.trim().split(/\s+/).length:0;words.textContent=n.toLocaleString();read.textContent=`${Math.ceil(n/225)} MIN`;if(dirty)saveState.textContent='UNSAVED'};
    [title,deck,body,genre].forEach(el=>el.addEventListener('input',()=>{dirty=true;count()}));
    function reset(){currentId=null;currentStatus='draft';title.value='';deck.value='';body.value='';genre.value='FANTASY';status.textContent='DRAFT';saveState.textContent='NEW';dirty=false;count();say('');workspace.hidden=false;library.hidden=true}
    async function save(){say('SAVING…');const payload={user_id:user.id,title:title.value.trim()||'Untitled manuscript',deck:deck.value.trim(),body:body.value,genre:genre.value,status:currentStatus};const r=currentId?await supabase.from('dr_writer_manuscripts').update(payload).eq('id',currentId).select().single():await supabase.from('dr_writer_manuscripts').insert(payload).select().single();if(r.error){say(r.error.message,true);return false}currentId=r.data.id;dirty=false;saveState.textContent='SAVED';say('SAVED.');return true}
    $('[data-save]').addEventListener('click',save);$('[data-new]').addEventListener('click',reset);$('[data-submit-editor]').addEventListener('click',async()=>{if(!body.value.trim()){say('WRITE SOMETHING BEFORE SENDING IT.',true);return}if(!(await save()))return;const {error}=await supabase.from('dr_writer_manuscripts').update({status:'submitted',submitted_at:new Date().toISOString()}).eq('id',currentId);if(error){say(error.message,true);return}currentStatus='submitted';status.textContent='WITH EDITOR';say('SENT TO EDITOR.')});
    const dlg=$('[data-preview-dialog]');$('[data-preview]').addEventListener('click',()=>{$('[data-preview-genre]').textContent=genre.value;$('[data-preview-title]').textContent=title.value.trim()||'Untitled';$('[data-preview-deck]').textContent=deck.value;$('[data-preview-author]').textContent=author.toUpperCase();const dest=$('[data-preview-body]');dest.innerHTML='';body.value.split(/\n\s*\n/).filter(Boolean).forEach(t=>{const p=document.createElement('p');p.textContent=t;dest.appendChild(p)});dlg.showModal()});$('[data-close-preview]').addEventListener('click',()=>dlg.close());
    async function showLibrary(kind){workspace.hidden=true;library.hidden=false;const cfg={drafts:['Manuscripts',['draft']],submitted:['With Editor',['submitted','ready']],published:['Published Works',['published']]}[kind];$('[data-library-title]').textContent=cfg[0];const list=$('[data-library-list]');list.innerHTML='<div class="writer-library__empty">LOADING…</div>';const {data,error}=await supabase.from('dr_writer_manuscripts').select('*').in('status',cfg[1]).order('updated_at',{ascending:false});if(error){list.textContent=error.message;return}if(!data.length){list.innerHTML='<div class="writer-library__empty">Nothing here yet.</div>';return}list.innerHTML='';data.forEach(item=>{const b=document.createElement('button');b.className='writer-library__item';b.innerHTML='<span></span><strong></strong><small></small>';b.children[0].textContent=item.genre;b.children[1].textContent=item.title;b.children[2].textContent=`${item.status.toUpperCase()} / ${new Date(item.updated_at).toLocaleDateString()}`;b.onclick=()=>{currentId=item.id;currentStatus=item.status;title.value=item.title;deck.value=item.deck||'';body.value=item.body||'';genre.value=item.genre||'FANTASY';status.textContent=item.status==='submitted'?'WITH EDITOR':item.status.toUpperCase();dirty=false;saveState.textContent='SAVED';count();workspace.hidden=false;library.hidden=true};list.appendChild(b)})}
    document.querySelectorAll('[data-view]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('is-active',b===btn));btn.dataset.view==='desk'?reset():showLibrary(btn.dataset.view)}));$('[data-signout]').addEventListener('click',async()=>{await supabase.auth.signOut();location.href='/'});$('[data-loading]').hidden=true;reset();
  </script>
</SiteLayout>
