---
import ArchiveSearch from "../components/ArchiveSearch.astro";
import MemberDock from "../components/MemberDock.astro";
import MemberTracker from "../components/MemberTracker.astro";
import "../styles/member-system.css";
import "../styles/core.css";
import "../styles/gaming.css";
import "../styles/journal.css";
import "../styles/public.css";
import "../styles/launch.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  ogImage?: string | null;
  ogType?: "website" | "article";
}

const {
  title = "DragonsRitual Gaming",
  description = "DragonsRitual gaming broadcasts, schedules, sessions and statistics.",
  canonical,
  noIndex = false,
  ogImage,
  ogType = "website"
} = Astro.props;

const privateRoutePrefixes = [
  "/admin",
  "/creator",
  "/writer-room",
  "/contributor-agreement",
  "/join",
  "/reset-password"
];
const routeIsPrivate = privateRoutePrefixes.some((prefix) => Astro.url.pathname.startsWith(prefix));
const effectiveNoIndex = noIndex || routeIsPrivate;

const isPublicLaunchRoute = Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/radio");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090c" />

    <meta name="application-name" content="DragonsRitual" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DragonsRitual" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/dr-192.png" />
    <link rel="apple-touch-icon" href="/icons/dr-192.png" />
    <link rel="canonical" href={canonical ?? Astro.url} />
    {effectiveNoIndex && <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical ?? Astro.url} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <title>{title}</title>
    <ClientRouter fallback="animate" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&display=swap" rel="stylesheet">
  </head>

  <body>
    <div id="dragon-media-dock" class="dragon-media-dock" hidden>
      <div class="dragon-media-dock__head"><span data-dock-label>DRAGON TV · CONTINUING</span><div><button type="button" data-dock-expand>EXPAND</button><button type="button" data-dock-return>RETURN</button><button type="button" data-dock-close aria-label="Close player">×</button></div></div>
      <div class="dragon-media-dock__player" data-dock-player><span>VIDEO CONTINUES HERE</span></div>
    </div>
    <slot />
    <MemberDock />
    <MemberTracker />

    {!isPublicLaunchRoute && <script is:inline src="/dragon-rail.js"></script>}
    <script is:inline>
      (() => {
        const isLocal =
          location.hostname === "localhost" ||
          location.hostname === "127.0.0.1";

        if (!isLocal && "serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker.register("/sw.js").catch((error) => {
              console.warn("DragonsRitual service worker registration failed.", error);
            });
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const dock=()=>document.getElementById('dragon-media-dock');
        window.DragonMediaDock={
          mount({src,title='DRAGON TV'}={}){
            const d=dock(),host=d?.querySelector('[data-dock-player]'),label=d?.querySelector('[data-dock-label]');
            if(!d||!host||!src)return;
            host.innerHTML='';
            const frame=document.createElement('iframe');
            frame.src=src; frame.allow='autoplay; fullscreen; picture-in-picture'; frame.allowFullscreen=true; frame.title=title;
            host.appendChild(frame);
            if(label)label.textContent=title;
            sessionStorage.setItem('dr-media-active','1');
            sessionStorage.setItem('dr-media-src',src);
            sessionStorage.setItem('dr-media-title',title);
            d.hidden=false;
          }
        };
        document.addEventListener('click',e=>{
          if(e.target.closest('[data-dock-expand]'))dock()?.classList.toggle('is-expanded');
        });
        document.addEventListener('astro:page-load',()=>{
          const d=dock(),host=d?.querySelector('[data-dock-player]');
          const src=sessionStorage.getItem('dr-media-src'),title=sessionStorage.getItem('dr-media-title');
          if(d&&host&&src&&sessionStorage.getItem('dr-media-active')==='1'&&!host.querySelector('iframe')){
            window.DragonMediaDock.mount({src,title:title||'DRAGON TV'});
          }
        });
      })();
    </script>
    <ArchiveSearch />
  <script is:inline src="/scripts/dragon-gaming-docks.js"></script>
</body>
</html>

