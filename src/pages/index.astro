---
import SiteLayout from '../layouts/SiteLayout.astro'; import PublicHeader from '../components/PublicHeader.astro'; import PublicFooter from '../components/PublicFooter.astro'; import { listPublishedArticles, type NewsroomArticleSummary } from '../services/journal'; import { getGamingDashboard } from '../services/gamingDashboardService';
let articles:NewsroomArticleSummary[]=[]; try{articles=(await listPublishedArticles()).slice(0,6)}catch(e){console.warn('TODAY journal unavailable',e)}
const gaming=await getGamingDashboard(); const lead=articles[0]; const upcoming=gaming.schedule?.[0];
---
<SiteLayout title="DragonsRitual — Today" description="A living studio for games, stories, creators, broadcasts, radio and community.">
<PublicHeader active="today"/><main class="world-main">
<section class="today-hero"><div class="today-lead"><span class="editorial-kicker">DRAGONSRITUAL / TODAY</span><h1>{lead?.title ?? 'Games, stories, creators and strange work worth finding.'}</h1><p>{lead?.subtitle ?? lead?.excerpt ?? 'A living independent studio and network: development, art, writing, broadcasts, creators, community and experiments collected in one place.'}</p><div class="today-lead__actions"><a class="dr-button dr-button--primary" href={lead?`/journal/${lead.slug}/`:'/projects/'}>{lead?'READ THE LEAD STORY':'ENTER PROJECTS'}</a><a class="dr-button" href="/journal/">EXPLORE STORIES</a></div></div><aside class="today-rail"><a class="signal-card" href="/live/"><span>LIVE / BROADCAST</span><h3>Enter the broadcast room</h3><p>Streams, sessions, clips and the live DragonsRitual feed.</p></a><a class="signal-card" href="/radio/"><span>RADIO</span><h3>Dark Cloud Radio</h3><p>Independent music, programs, audio and future live station activity.</p></a><a class="signal-card" href="/community/"><span>COMMUNITY</span><h3>The forum is taking shape</h3><p>Old-school discussion structure with a modern creator network behind it.</p></a></aside></section>
<section class="editorial-section"><div class="editorial-head"><div><span class="editorial-kicker">LATEST DISPATCHES</span><h2>Stories & field notes</h2></div><p>Development journals, essays, creator features, studio reports and things worth keeping.</p></div><div class="story-grid">{articles.length?articles.slice(0,3).map(a=><a class="story-card" href={`/journal/${a.slug}/`}><time>{a.publishedAt?new Date(a.publishedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'JOURNAL'}</time><h3>{a.title}</h3><p>{a.subtitle??a.excerpt??'Open dispatch.'}</p></a>):<a class="story-card" href="/journal/"><span>NEWSROOM</span><h3>The journal is ready for the next dispatch.</h3><p>Published stories will automatically enter this front page.</p></a>}</div></section>
<section class="editorial-section"><div class="editorial-head"><div><span class="editorial-kicker">AROUND THE RITUAL</span><h2>Choose a door</h2></div><p>Simple entrances into a much larger network.</p></div><div class="world-grid"><a class="world-door" href="/creators/"><b>Creators</b><span>Artists, writers, musicians, collaborators and featured work.</span></a><a class="world-door" href="/projects/"><b>Projects</b><span>Games, software, experiments and work currently in development.</span></a><a class="world-door" href="/live/"><b>Live</b><span>Broadcasts, gaming sessions, recordings and clips.</span></a><a class="world-door" href="/community/"><b>Community</b><span>Forum discussions, gatherings and the people around the work.</span></a></div></section>
<section class="editorial-section"><div class="editorial-head"><div><span class="editorial-kicker">FROM THE WORKSHOP</span><h2>Current play</h2></div><p>{upcoming?`Next scheduled: ${upcoming.game} — ${upcoming.date}`:'Projects and gaming sessions feed the public record here.'}</p></div><div class="story-grid">{gaming.games.slice(0,3).map(g=><a class="story-card" href="/projects/"><span>{g.platform} · {g.status}</span><h3>{g.title}</h3><p>{g.sessions} sessions · {g.hours} hours logged · {g.progress}% progress</p></a>)}</div></section>
</main><PublicFooter/></SiteLayout>
