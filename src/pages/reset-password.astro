---
import SiteLayout from "../layouts/SiteLayout.astro";
import LaunchHeader from "../components/LaunchHeader.astro";
---
<SiteLayout title="Reset Password — DRAGON" description="Reset your DragonsRitual creator password.">
  <LaunchHeader />
  <main class="wr-auth">
    <section class="wr-auth__card">
      <span class="wr-kicker">DRAGON / CREATOR ACCESS</span>
      <h1>Reset the key.</h1>
      <p class="wr-lede">Choose a new password for your creator account.</p>

      <form class="wr-form" data-reset-form>
        <label>
          <span>NEW PASSWORD</span>
          <input name="password" type="password" minlength="8" autocomplete="new-password" required placeholder="8+ characters" />
        </label>
        <label>
          <span>CONFIRM PASSWORD</span>
          <input name="confirm_password" type="password" minlength="8" autocomplete="new-password" required placeholder="Repeat password" />
        </label>
        <button class="wr-primary" type="submit" data-reset-submit>SET NEW PASSWORD</button>
      </form>

      <p class="wr-message" data-message aria-live="polite"></p>
      <a class="wr-back" href="/join/">← RETURN TO SIGN IN</a>
    </section>
  </main>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const message = document.querySelector('[data-message]');
    const form = document.querySelector('[data-reset-form]');
    const submit = document.querySelector('[data-reset-submit]');

    const say = (text, bad=false) => {
      message.textContent = text;
      message.classList.toggle('is-error', bad);
    };

    if (!url || !key) {
      say('Creator access is not connected.', true);
    } else {
      const supabase = createClient(url, key);

      const hash = new URLSearchParams(window.location.hash.replace(/^#/, ''));
      const accessToken = hash.get('access_token');
      const refreshToken = hash.get('refresh_token');
      const type = hash.get('type');

      if (accessToken && refreshToken && type === 'recovery') {
        const { error } = await supabase.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken
        });
        if (error) say(error.message, true);
        else {
          history.replaceState({}, document.title, window.location.pathname);
          say('RECOVERY VERIFIED — CHOOSE YOUR NEW PASSWORD.');
        }
      } else {
        const { data:{ session } } = await supabase.auth.getSession();
        if (!session) say('Open this page from a fresh password-recovery email.', true);
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const password = form.password.value;
        const confirm = form.confirm_password.value;

        if (password !== confirm) {
          say('PASSWORDS DO NOT MATCH.', true);
          return;
        }

        submit.disabled = true;
        say('UPDATING…');

        const { error } = await supabase.auth.updateUser({ password });

        if (error) {
          say(error.message, true);
          submit.disabled = false;
          return;
        }

        form.reset();
        say('PASSWORD UPDATED. ENTERING WRITER ROOM…');
        setTimeout(() => window.location.href = '/writer-room/', 700);
      });
    }
  </script>
</SiteLayout>
