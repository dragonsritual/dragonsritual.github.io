---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import LaunchHeader from '../../../components/LaunchHeader.astro';
import GamingRealmWire from '../../../components/GamingRealmWire.astro';
import GamingWorldBossBar from '../../../components/GamingWorldBossBar.astro';
import '../../../styles/gaming.css';
import '../../../styles/world-boss.css';
import GamingActiveWizard from '../../../components/GamingActiveWizard.astro';
import GamingRealmStatus from '../../../components/GamingRealmStatus.astro';
---
<SiteLayout title="World Boss — Dragon Gaming" description="A public Dragon Gaming realm event.">
<LaunchHeader />
<main class="boss-page" data-boss-page>
  <GamingRealmStatus />
  <GamingActiveWizard />
  <GamingRealmWire />
  <GamingWorldBossBar compact={true} />
  <nav class="boss-nav"><a href="/gaming/">← LOUNGE</a><span>PUBLIC EVENT / RAID ARCHIVE 001</span><b>REALM PROTOTYPE</b></nav>

  <header class="boss-hero">
    <div class="boss-hero__seal"><span>WORLD BOSS</span><b>?</b><small>VISUAL RECORD<br/>UNRECOVERED</small></div>
    <div class="boss-hero__copy">
      <span class="boss-kicker">THE DEEP BELOW / OSSUARY GATE</span>
      <h1>VHALZUR,<br/><em>THE BURIED MOUTH</em></h1>
      <p>No surviving witness agrees on Vhalzur's shape. The event deliberately withholds the creature itself: the Realm knows it through pressure, casualties, recovered text, and the impossible quantity of life still measured beneath the Gate.</p>
      <div class="boss-tags"><span>LV 72</span><span>WORLD ENTITY</span><span>CHTHONIC</span><span>PUBLIC RAID</span></div>
    </div>
    <aside class="boss-hero__status"><small>EVENT STATE</small><strong>ENGAGED</strong><span>ALL ELIGIBLE WIZARDS MAY CONTRIBUTE</span><hr/><small>RECOMMENDED</small><b>LV 5+</b><small>LOWER LEVELS CAN STILL ASSIST</small></aside>
  </header>

  <section class="boss-grid">
    <div class="boss-main">
      <article class="boss-panel boss-lore">
        <header><span>ARCHIVE / LORE</span><h2>What the Spire Knows</h2></header>
        <p>For nine generations the Ossuary Gate was catalogued as a sealed architectural failure beneath the oldest mapped foundations. Then the Gate began to breathe.</p>
        <p>Records recovered from the lower library describe a thing imprisoned before the present orders of wizardry had names. It does not climb. It does not hunt. It waits while the structures above it slowly become part of its body.</p>
        <blockquote>“Do not ask what is beneath the Gate. Ask how much of the Gate is already beneath it.” <small>— fragment, author removed from the Registry</small></blockquote>
      </article>

      <article class="boss-panel">
        <header><span>COMBAT INTELLIGENCE</span><h2>Realm Combat Record</h2></header>
        <div class="boss-intel">
          <div><small>ARMOR</small><b>OSSIFIED PLATE</b><p>Reduces ordinary physical contributions. Higher wizard Power improves penetration.</p></div>
          <div><small>WARD</small><b>HUNGER VEIL</b><p>Insight and studied magick improve ritual damage against the veil.</p></div>
          <div><small>WEAK CONDITION</small><b>RESONANT TEXT</b><p>Book discoveries and knowledge can later unlock raid-wide vulnerability windows.</p></div>
          <div><small>RETALIATION</small><b>GRAVE PRESSURE</b><p>Attempts can exhaust the wizard. Resting before contributing matters.</p></div>
        </div>
      </article>

      <article class="boss-panel boss-contribute">
        <header><span>CONTRIBUTE TO THE PUBLIC FIGHT</span><h2>Your Wizard Enters the Record</h2></header>
        <div class="boss-wizard" data-boss-wizard>
          <div><small>ACTIVE CHARACTER</small><strong data-wiz-name>NO WIZARD LINKED</strong><span>LV <b data-wiz-level>—</b> · <b data-wiz-element>UNBOUND</b></span></div>
          <div><small>COMBAT ESTIMATE</small><strong data-wiz-rating>—</strong><span>LEVEL + POWER + INSIGHT + VITALITY</span></div>
          <div><small>PLAY TIME</small><strong data-wiz-time>0m</strong><span>NINTH SPIRE</span></div>
        </div>
        <div class="boss-actions">
          <button data-boss-action="strike"><b>⚔</b><span>ARCANE STRIKE<small>Reliable direct contribution</small></span></button>
          <button data-boss-action="ritual"><b>◇</b><span>WARD RITUAL<small>Insight-weighted assault</small></span></button>
          <button data-boss-action="support"><b>✦</b><span>REALM SUPPORT<small>Lower damage · helps any level</small></span></button>
        </div>
        <div class="boss-result" data-boss-result>Choose how your wizard contributes. Each prototype attempt has a short cooldown.</div>
        <p class="boss-warning"><b>PROTOTYPE:</b> Damage is local in this pass so we can tune the loop safely. The server pass will make boss HP, contributions, rewards and rankings authoritative for every member.</p>
      </article>

      <article class="boss-panel">
        <header><span>REWARDS / THRESHOLDS</span><h2>What the Realm Is Fighting For</h2></header>
        <div class="boss-rewards">
          <div><b>75%</b><span>Archive fragment unlocked</span></div><div><b>50%</b><span>Realm-wide title challenge</span></div><div><b>25%</b><span>Relic table revealed</span></div><div><b>0%</b><span>Boss defeated · permanent Chronicle mark</span></div>
        </div>
      </article>
    </div>

    <aside class="boss-side">
      <section class="boss-panel"><header><span>YOUR RAID RECORD</span><h2>Contribution</h2></header><dl><div><dt>DAMAGE</dt><dd data-side-damage>0</dd></div><div><dt>ATTEMPTS</dt><dd data-side-attempts>0</dd></div><div><dt>BEST HIT</dt><dd data-side-best>0</dd></div><div><dt>STATUS</dt><dd data-side-rank>UNRANKED</dd></div></dl></section>
      <section class="boss-panel"><header><span>PUBLIC LEDGER</span><h2>Raid Leaders</h2></header><div class="boss-ledger"><p>Global member rankings activate when the event is moved to Supabase.</p><span>01 — WAITING FOR LIVE REALM</span><span>02 — WAITING FOR LIVE REALM</span><span>03 — WAITING FOR LIVE REALM</span></div></section>
      <section class="boss-panel"><header><span>EVENT RULES</span><h2>Participation</h2></header><ul><li>One DragonsRitual character contributes per attempt.</li><li>Level helps, but does not exclude new members.</li><li>Future gear, spells, affinities and raid conditions modify contribution.</li><li>Server validates damage before it reaches global HP.</li><li>Rewards use participation tiers, not only top damage.</li></ul></section>
    </aside>
  </section>
</main>
<script>
(()=>{
 const BOSS='dragon:gaming:world-boss:vhalzur-001', CHAR='dragon:ninth-spire:character', MAX=9600000, COOLDOWN=12000;
 const $=s=>document.querySelector(s);
 const duration=ms=>{const m=Math.floor((Number(ms)||0)/60000);return m<60?`${m}m`:`${Math.floor(m/60)}h ${m%60}m`};
 const read=(k,f)=>{try{return JSON.parse(localStorage.getItem(k)||'null')||f}catch{return f}};
 let c=read(CHAR,null), s=read(BOSS,{bossId:'vhalzur-001',hp:MAX,maxHp:MAX,personalDamage:0,attempts:0,bestHit:0,lastAttempt:0});
 function character(){c=read(CHAR,null); if(!c)return; $('[data-wiz-name]').textContent=c.name||'WIZARD';$('[data-wiz-level]').textContent=c.level||1;$('[data-wiz-element]').textContent=(c.element||'UNBOUND').toUpperCase();$('[data-wiz-time]').textContent=duration(c.playTimeMs);$('[data-wiz-rating]').textContent=Math.round((c.level||1)*12+(c.power||0)*3+(c.insight||0)*2+(c.vitality||0)*2).toLocaleString();}
 function paint(){localStorage.setItem(BOSS,JSON.stringify(s));$('[data-side-damage]').textContent=Math.round(s.personalDamage||0).toLocaleString();$('[data-side-attempts]').textContent=s.attempts||0;$('[data-side-best]').textContent=Math.round(s.bestHit||0).toLocaleString();$('[data-side-rank]').textContent=s.personalDamage>0?'CONTRIBUTOR':'UNRANKED';dispatchEvent(new CustomEvent('dragon:boss:update',{detail:s}));}
 function attack(kind){
   character(); if(!c){$('[data-boss-result]').textContent='Enter The Ninth Spire and create/link a wizard before joining the raid.';return}
   const now=Date.now(), left=COOLDOWN-(now-(s.lastAttempt||0)); if(left>0){$('[data-boss-result]').textContent=`Your wizard is recovering. ${Math.ceil(left/1000)}s until another contribution.`;return}
   const level=Math.max(1,Number(c.level)||1),power=Number(c.power)||0,insight=Number(c.insight)||0,vitality=Number(c.vitality)||0;
   let base=0,label='';
   if(kind==='strike'){base=70+level*18+power*5+vitality*2;label='Arcane Strike'}
   if(kind==='ritual'){base=55+level*14+insight*7+power*2;label='Ward Ritual'}
   if(kind==='support'){base=45+level*10+insight*2+vitality*3;label='Realm Support'}
   const variance=.88+Math.random()*.24, dmg=Math.max(1,Math.round(base*variance));
   s.hp=Math.max(0,(Number(s.hp)||MAX)-dmg);s.personalDamage=(s.personalDamage||0)+dmg;s.attempts=(s.attempts||0)+1;s.bestHit=Math.max(s.bestHit||0,dmg);s.lastAttempt=now;paint();
   $('[data-boss-result]').innerHTML=`<b>${label.toUpperCase()}</b> · ${dmg.toLocaleString()} realm damage recorded.`;
   try{const log=JSON.parse(localStorage.getItem('dragon:gaming:realm-wire')||'[]');log.unshift({type:'character',tone:'crimson',text:`${c.name||'A wizard'} struck Vhalzur for ${dmg.toLocaleString()} damage.`,at:Date.now()});localStorage.setItem('dragon:gaming:realm-wire',JSON.stringify(log.slice(0,80)))}catch{}
 }
 document.querySelectorAll('[data-boss-action]').forEach(b=>b.addEventListener('click',()=>attack(b.dataset.bossAction)));
 character();paint();
})();
</script>
</SiteLayout>