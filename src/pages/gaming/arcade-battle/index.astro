---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import LaunchHeader from '../../../components/LaunchHeader.astro';
import GamingWorldBossBar from '../../../components/GamingWorldBossBar.astro';
import '../../../styles/gaming.css';
---
<SiteLayout title="Arcade Battle — Dragon Gaming" description="The official DragonsRitual Arcade Battle browser game: plan your party, read enemy intent, survive the waves and build a run.">
  <LaunchHeader />
  <main class="arcade-site">
    <GamingWorldBossBar />

    <nav class="arcade-nav">
      <a href="/gaming/">← LOUNGE</a>
      <div>
        <span>DRAGON GAMING / PLAYABLE REALM</span>
        <strong>ARCADE BATTLE</strong>
      </div>
      <div class="arcade-nav__status"><i></i> ARCADE EDITION LIVE</div>
    </nav>

    <section class="arcade-intro">
      <div class="arcade-intro__copy">
        <span>REALM 003 / DRAGONSRITUAL ARCADE</span>
        <h1>PLAN THE PARTY.<br/>READ THE ENEMY.<br/>SURVIVE THE WAVE.</h1>
        <p>This is the original Arcade Battle combat game, now expanded by the Ritual Draw. Every run cracks open a random three-combatant lineup from more than fifty registered visual archetypes, then deals rarity, affinity, rules text and artifacts on top of the existing battlefield, enemy-intent, turn-order, elite and boss systems.</p>
        <div class="arcade-chips">
          <b>TURN-BASED</b><b>PARTY COMBAT</b><b>BOOSTER RUNS</b><b>50+ ARCHETYPES</b><b>DESKTOP + MOBILE</b>
        </div>
      </div>
      <img src="/images/gaming/arcade-battle-banner.png" alt="DragonsRitual Arcade Battle" />
    </section>

    <section class="arcade-frame">
      <iframe
        title="DragonsRitual Arcade Battle"
        src="/games/arcade-battle/index.html?v=website02"
        allow="fullscreen"
        data-arcade-frame
      ></iframe>
    </section>

    <footer class="arcade-footer">
      <span>ARCADE BATTLE · OFFICIAL WEBSITE BUILD</span>
      <p>The collectible rarity / affinity / artifact draw system is now layered directly onto the original Arcade Battle game. Death still ends the run; discoveries survive only in the Collection archive.</p>
      <button type="button" data-arcade-fullscreen>FULL SCREEN</button>
    </footer>
  </main>

  <script>
    const frame=document.querySelector('[data-arcade-frame]');
    document.querySelector('[data-arcade-fullscreen]')?.addEventListener('click',async()=>{
      try{
        if(document.fullscreenElement) await document.exitFullscreen();
        else await frame?.requestFullscreen();
      }catch{}
    });
  </script>

  <style>
    .arcade-site{min-height:100vh;background:#070607;color:#ddd}
    .arcade-nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:15px;padding:8px 14px;border-bottom:1px solid #35222a;background:#080708}
    .arcade-nav a{color:#8d7780;text-decoration:none;font:700 7px Arial}
    .arcade-nav>div:nth-child(2){text-align:center}
    .arcade-nav span,.arcade-nav__status{display:block;color:#755c66;font:700 6px Arial;letter-spacing:.12em}
    .arcade-nav strong{font:500 13px Georgia;color:#d7c7cd}
    .arcade-nav__status{text-align:right}
    .arcade-nav__status i{display:inline-block;width:6px;height:6px;margin-right:6px;border-radius:50%;background:#4fc977;box-shadow:0 0 10px #4fc97777}

    .arcade-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.72fr);gap:24px;align-items:center;padding:34px max(5vw,24px);border-bottom:1px solid #2d2025;background:radial-gradient(circle at 70% 0,#35162955,transparent 36%),#090709}
    .arcade-intro__copy>span{color:#b78b3c;font:800 7px Arial;letter-spacing:.14em}
    .arcade-intro h1{margin:8px 0 12px;font:500 clamp(34px,4.7vw,68px)/.9 Georgia;color:#ead9c1}
    .arcade-intro p{max-width:720px;color:#9d8790;font:11px/1.7 Arial}
    .arcade-intro img{display:block;width:100%;max-height:285px;object-fit:cover;border:1px solid #55333f;box-shadow:0 20px 55px #0008}
    .arcade-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}
    .arcade-chips b{padding:6px 8px;border:1px solid #3b2930;color:#a98f98;background:#0a080a;font:800 7px Arial;letter-spacing:.08em}

    .arcade-frame{width:min(1400px,calc(100% - 24px));height:min(860px,80vh);margin:18px auto;border:1px solid #55333f;background:#050405;box-shadow:0 28px 80px #0008}
    .arcade-frame iframe{width:100%;height:100%;border:0;background:#050405}
    .arcade-footer{display:flex;gap:18px;align-items:center;padding:10px 14px;border-top:1px solid #302027;color:#77676d;font:7px Arial}
    .arcade-footer span{color:#b78b3c;font-weight:800;letter-spacing:.1em}
    .arcade-footer p{margin:0;flex:1}
    .arcade-footer button{border:1px solid #55333f;background:#0c080c;color:#cdbbc1;padding:8px 10px;font:800 7px Arial;letter-spacing:.08em;cursor:pointer}

    @media(max-width:800px){
      .arcade-nav{grid-template-columns:auto 1fr}
      .arcade-nav__status{display:none}
      .arcade-intro{grid-template-columns:1fr;padding:24px 14px 18px}
      .arcade-intro img{order:-1;max-height:230px}
      .arcade-frame{width:100%;height:76svh;margin:0;border-left:0;border-right:0}
      .arcade-footer{display:grid;grid-template-columns:1fr auto}
      .arcade-footer p{grid-column:1/-1}
    }
  </style>
</SiteLayout>
