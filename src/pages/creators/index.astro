---
import SiteLayout from '../../layouts/SiteLayout.astro'; import PublicPage from '../../components/PublicPage.astro';
---
<SiteLayout title="Creators — DragonsRitual"><PublicPage active="creators" eyebrow="THE CREATOR NETWORK" title="People worth discovering." intro="Artists, musicians, writers, developers and collaborators. Creator features published from Dragon Console will collect here."><section class="section-cards" id="creator-feed"><article class="section-card"><small>NETWORK</small><h2>Creator features are connected.</h2><p>This page can receive creator-feature data published by Dragon Console. The public directory will grow without hand-building a new page for every collaborator.</p><a href="/journal/">READ CURRENT STORIES →</a></article></section><script is:inline>fetch('/data/creator-features/index.json').then(r=>r.ok?r.json():[]).then(d=>{const items=Array.isArray(d)?d:(d.features||d.items||[]);if(!items.length)return;document.querySelector('#creator-feed').innerHTML=items.map(x=>`<article class="section-card"><small>CREATOR FEATURE</small><h2>${x.creatorName||x.name||x.title||'Creator'}</h2><p>${x.excerpt||x.subtitle||'Featured in the DragonsRitual network.'}</p><a href="/creators/${x.slug}/">VIEW FEATURE →</a></article>`).join('')}).catch(()=>{});</script></PublicPage></SiteLayout>
