const epoch = Date.UTC(2026, 0, 1);
const today = new Date();
const utcDay = Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate());
const dayNumber = Math.floor((utcDay - epoch) / 86400000);
const selected = words[((dayNumber % words.length) + words.length) % words.length];
---

<aside class="dragon-word-mini" data-word-card aria-labelledby="dragon-word-title">
  <div class="dragon-word-mini__core">
    <span class="dragon-word-mini__label">WORD OF THE DAY</span>

    <div class="dragon-word-mini__word">
      <h2 id="dragon-word-title">{selected.word}</h2>
      <span>{selected.part}</span>
      <button type="button" data-word-speak data-word={selected.word} aria-label={`Hear ${selected.word}`}>◖)))</button>
    </div>

    <p>{selected.definition}</p>

    <button class="dragon-word-mini__open" type="button" data-word-toggle aria-expanded="false">
      OPEN WORD
    </button>
  </div>

  <div class="dragon-word-mini__details" data-word-details hidden>
    <div class="dragon-word-mini__detail-grid">
      <div>
        <small>PRONUNCIATION</small>
        <strong>/{selected.pronunciation}/</strong>
      </div>
      <div>
        <small>ORIGIN</small>
        <span>{selected.origin}</span>
      </div>
      <div>
        <small>RELATED</small>
        <span>{selected.related.join(" · ")}</span>
      </div>
    </div>

    <blockquote>“{selected.example}”</blockquote>
    <p class="dragon-word-mini__note">{selected.note}</p>

    <div class="dragon-word-mini__actions">
      <button type="button" data-word-save data-word={selected.word}>☆ SAVE WORD</button>
      <button type="button" data-word-copy data-word={selected.word}>COPY</button>
    </div>
  </div>
</aside>

<script>
  const root = document.querySelector('[data-word-card]');
  const details = root?.querySelector('[data-word-details]');
  const toggle = root?.querySelector('[data-word-toggle]');

  toggle?.addEventListener('click', () => {
    if (!details) return;
    const willOpen = details.hasAttribute('hidden');
    details.toggleAttribute('hidden', !willOpen);
    toggle.setAttribute('aria-expanded', String(willOpen));
    toggle.textContent = willOpen ? 'CLOSE WORD' : 'OPEN WORD';
  });

  const speakBtn = root?.querySelector('[data-word-speak]');
  speakBtn?.addEventListener('click', () => {
    const word = speakBtn.getAttribute('data-word') || '';
    if (!word || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(word);
    utterance.rate = 0.82;
    window.speechSynthesis.speak(utterance);
  });

  const copyBtn = root?.querySelector('[data-word-copy]');
  copyBtn?.addEventListener('click', async () => {
    const word = copyBtn.getAttribute('data-word') || '';
    if (!word) return;
    try {
      await navigator.clipboard.writeText(word);
      const before = copyBtn.textContent;
      copyBtn.textContent = 'COPIED';
      setTimeout(() => copyBtn.textContent = before || 'COPY', 900);
    } catch {}
  });

  const saveBtn = root?.querySelector('[data-word-save]');
  const savedKey = 'dragon:lexicon:saved';
  const word = saveBtn?.getAttribute('data-word') || '';

  function savedWords() {
    try { return JSON.parse(localStorage.getItem(savedKey) || '[]'); }
    catch { return []; }
  }

  function syncSave() {
    if (!saveBtn || !word) return;
    const saved = savedWords().includes(word);
    saveBtn.textContent = saved ? '★ SAVED' : '☆ SAVE WORD';
    saveBtn.classList.toggle('is-saved', saved);
  }

  saveBtn?.addEventListener('click', () => {
    if (!word) return;
    const set = new Set(savedWords());
    set.has(word) ? set.delete(word) : set.add(word);
    localStorage.setItem(savedKey, JSON.stringify([...set]));
    syncSave();
  });

  syncSave();
</script>
