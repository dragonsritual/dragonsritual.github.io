---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const {
  eyebrow,
  title,
  description
} = Astro.props;
---

<header class="section-heading">
  <div>
    {eyebrow && <span>{eyebrow}</span>}
    <h2>{title}</h2>
  </div>

  {description && <p>{description}</p>}
</header>