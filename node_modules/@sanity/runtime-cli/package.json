{
  "name": "@sanity/runtime-cli",
  "description": "Sanity's Runtime CLI for Blueprints and Functions",
  "version": "17.4.0",
  "author": "Sanity Runtime Team",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/runtime-cli.git"
  },
  "bugs": "https://github.com/sanity-io/runtime-cli/issues",
  "homepage": "https://github.com/sanity-io/runtime-cli",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "bin": {
    "sanity-run": "bin/run.js"
  },
  "scripts": {
    "build": "npm run build:rollup && npm run build:ts && npm run build:static && npm run build:oclif",
    "build:rollup": "rollup -c",
    "build:oclif": "oclif manifest && oclif readme",
    "build:ts": "shx rm -rf dist *.tsbuildinfo && tsc -b",
    "build:static": "npm run copy:wrapper && npm run copy:design-tokens && npm run copy:server",
    "clean": "shx rm -rf dist oclif.manifest.json",
    "copy:design-tokens": "shx rm -rf ./src/server/static/vendor/design-tokens && shx cp -r ./node_modules/@sanity-labs/design-tokens/dist/css ./src/server/static/vendor/design-tokens",
    "copy:server": "shx cp -r ./src/server/static ./dist/server",
    "copy:wrapper": "npm run copy:wrapper:entry && npm run copy:wrapper:modules",
    "copy:wrapper:entry": "shx cp ./src/utils/functions/child-process-wrapper.js ./dist/utils/functions/child-process-wrapper.js",
    "copy:wrapper:modules": "shx rm -rf ./dist/utils/functions/child-runtime && shx cp -r ./src/utils/functions/child-runtime ./dist/utils/functions/child-runtime",
    "lint": "biome ci",
    "lint:write": "biome check --write",
    "lint:fix": "npm run lint:write",
    "prepare": "npm run build",
    "postpack": "shx rm -f oclif.manifest.json",
    "test": "vitest run && npm run test:depmgmt && npm run lint",
    "test:depmgmt": "vitest run --config ./test-depmgmt/vitest.config.ts",
    "test:coverage": "vitest run --coverage --coverage.include \"runtime-cli/src/**/*\"",
    "test:scenarios": "vitest run test/scenarios",
    "test:playwright": "playwright install chromium && playwright install-deps chromium && playwright test",
    "test:bp-version-smoke": "node ./test/blueprints-version-smoke.js",
    "test:unit": "vitest run --exclude \"test/scenarios/**/*\"",
    "test:vitest": "vitest run",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@architect/hydrate": "~6.0.2",
    "@architect/inventory": "~6.1.0",
    "@inquirer/prompts": "^8.5.2",
    "@oclif/core": "^4.13.2",
    "@oclif/plugin-help": "^6.2.55",
    "@sanity-labs/design-tokens": "^0.0.2-alpha.2",
    "@sanity/blueprints": "^0.23.1",
    "@sanity/blueprints-parser": "^0.4.0",
    "@sanity/cli-build": "^5.1.0",
    "@sanity/cli-core": "^2.7.1",
    "@sanity/client": "^7.26.0",
    "adm-zip": "^0.6.0",
    "array-treeify": "^0.1.5",
    "cardinal": "^2.1.1",
    "empathic": "^2.0.1",
    "eventsource": "^4.1.0",
    "groq-js": "^2.0.0",
    "jiti": "^2.7.0",
    "mime-types": "^3.0.2",
    "ora": "^9.4.1",
    "signal-exit": "^4.1.0",
    "strip-ansi": "^7.2.0",
    "tar-fs": "^3.1.3",
    "tar-stream": "^3.2.0",
    "vite": "^8.1.5",
    "ws": "^8.21.1",
    "xdg-basedir": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@enhance/store": "^1.0.2",
    "@lezer/highlight": "^1.2.3",
    "@oclif/test": "^4.1.21",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@sanity/functions": "^1.5.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cardinal": "^2.1.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "codemirror": "^6.0.2",
    "mentoss": "^0.13.0",
    "oclif": "^4.23.29",
    "pretty-bytes": "^7.1.1",
    "pretty-ms": "^9.3.0",
    "rollup": "^4.62.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "oclif": {
    "bin": "sanity-run",
    "dirname": "sanity-run",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "blueprints": {
        "description": "Local Blueprint and remote Stack management commands"
      },
      "functions": {
        "description": "Sanity Function development and management commands"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
