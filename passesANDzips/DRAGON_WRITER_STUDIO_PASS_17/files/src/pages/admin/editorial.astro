---
import SiteLayout from "../../layouts/SiteLayout.astro";
import LaunchHeader from "../../components/LaunchHeader.astro";
---
<SiteLayout title="Editorial Desk — DRAGON" description="DragonsRitual editorial review queue."><LaunchHeader/><main class="wr17-editorial"><header><span class="wr-kicker">DRAGON / EDITORIAL CONTROL</span><h1>EDITORIAL<br/>DESK</h1><p>Review the work. Protect the standard. Decide where it belongs.</p></header><div class="wr17-editorial-grid"><aside><div class="wr17-editorial-tabs"><button data-filter="submitted" class="is-active">INBOX</button><button data-filter="ready">READY</button><button data-filter="published">PUBLISHED</button></div><div data-editor-list></div></aside><article data-editor-empty><span class="wr-kicker">NO FILE OPEN</span><h2>Select a submission.</h2></article><article data-editor-detail hidden><div class="wr17-editor-meta"><span data-e-type></span><span data-e-author></span><span data-e-words></span></div><h2 data-e-title></h2><p data-e-deck></p><div class="wr17-editor-images" data-e-images></div><div class="wr17-editor-body" data-e-body></div><section class="wr17-editor-controls"><label>EDITOR NOTE<textarea data-e-note placeholder="Feedback for the writer…"></textarea></label><label>FINAL PLACEMENT<select data-e-placement><option>TODAY FEATURE</option><option>FICTION</option><option>CULTURE</option><option>GAMES</option><option>ART</option><option>MUSIC</option><option>JOURNAL</option><option>ARCHIVE</option></select></label><div><button data-return>RETURN TO WRITER</button><button data-ready>MARK READY</button><button class="wr-primary" data-publish>APPROVE / PUBLISH STATE</button></div><p data-e-message></p></section></article></div></main>
<script>
import {getSupabaseBrowserClient} from '../../lib/supabaseBrowser'; const supabase=getSupabaseBrowserClient(); const {data:{session}}=await supabase.auth.getSession(); if(!session){location.href='/join/'}
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)]; let current=null,filter='submitted'; const wc=t=>t?.trim()?t.trim().split(/\s+/).length:0;
async function load(){const list=$('[data-editor-list]');list.innerHTML='LOADING…';const {data,error}=await supabase.from('dr_writer_manuscripts').select('*').eq('status',filter).order(filter==='submitted'?'submitted_at':'updated_at',{ascending:false});if(error){list.innerHTML=`<p class="is-error">${error.message}<br><br>Sign in with the studio editor account and run PASS 17 SQL.</p>`;return}list.innerHTML='';if(!data.length){list.innerHTML='<p class="wr17-editor-empty">Queue clear.</p>';return}data.forEach(x=>{const b=document.createElement('button');b.className='wr17-editor-file';b.innerHTML='<span></span><strong></strong><small></small>';b.children[0].textContent=`${x.content_type||'STORY'} / ${x.intended_section||'EDITOR DECIDES'}`;b.children[1].textContent=x.title;b.children[2].textContent=`${wc(x.body).toLocaleString()} WORDS · ${new Date(x.updated_at).toLocaleDateString()}`;b.onclick=()=>open(x);list.appendChild(b)})}
function open(x){current=x;$('[data-editor-empty]').hidden=true;$('[data-editor-detail]').hidden=false;$('[data-e-type]').textContent=`${x.content_type||'STORY'} / ${x.genre}`;$('[data-e-author]').textContent=x.user_id;$('[data-e-words]').textContent=`${wc(x.body)} WORDS`;$('[data-e-title]').textContent=x.title;$('[data-e-deck]').textContent=x.deck||'';$('[data-e-note]').value=x.editor_note||'';$('[data-e-placement]').value=x.placement||x.intended_section||'TODAY FEATURE';const bd=$('[data-e-body]');bd.innerHTML='';(x.body||'').split(/\n\s*\n/).filter(Boolean).forEach(t=>{const p=document.createElement('p');p.textContent=t;bd.appendChild(p)});const im=$('[data-e-images]');im.innerHTML='';(x.media_urls||[]).forEach(u=>{const i=document.createElement('img');i.src=u;im.appendChild(i)})}
async function setState(state){if(!current)return;const patch={status:state,editor_note:$('[data-e-note]').value,placement:$('[data-e-placement]').value};if(state==='published')patch.published_at=new Date().toISOString();const {error}=await supabase.from('dr_writer_manuscripts').update(patch).eq('id',current.id);$('[data-e-message]').textContent=error?error.message:`SAVED AS ${state.toUpperCase()}`;if(!error){current=null;$('[data-editor-detail]').hidden=true;$('[data-editor-empty]').hidden=false;load()}}
$('[data-return]').onclick=()=>setState('draft');$('[data-ready]').onclick=()=>setState('ready');$('[data-publish]').onclick=()=>setState('published');$$('[data-filter]').forEach(b=>b.onclick=()=>{$$('[data-filter]').forEach(x=>x.classList.toggle('is-active',x===b));filter=b.dataset.filter;load()});load();
</script></SiteLayout>
