---
import SiteLayout from "../layouts/SiteLayout.astro";
import LaunchHeader from "../components/LaunchHeader.astro";
---
<SiteLayout title="Contributor Agreement — DRAGON" description="DragonsRitual contributor access agreement.">
  <LaunchHeader />
  <main class="dr-agreement">
    <section class="dr-agreement__shell">
      <header class="dr-agreement__head">
        <span class="wr-kicker">DRAGON / CONTRIBUTOR ACCESS</span>
        <h1>Before you<br/>enter the room.</h1>
        <p>
          DragonsRitual gives invited contributors access to private creative spaces,
          unpublished work, editorial tools, and developing projects. This agreement
          keeps that material inside the studio while protecting the contributor's own work.
        </p>
      </header>

      <aside class="dr-agreement__summary">
        <span class="wr-kicker">THE SHORT VERSION</span>
        <ul>
          <li>Private and unpublished material stays inside DragonsRitual.</li>
          <li>Do not screenshot, copy, leak, repost, or discuss confidential studio material outside the project.</li>
          <li>Your original work remains yours unless a separate written agreement says otherwise.</li>
          <li>Submitting work gives DragonsRitual permission to review it; publication requires editorial approval.</li>
          <li>If DragonsRitual publishes your accepted work, you grant the studio the license described below to display and promote it.</li>
          <li>Only upload material you created or have permission to use.</li>
          <li>Contributor access can be ended by either side.</li>
          <li>Confidentiality continues after access ends.</li>
        </ul>
      </aside>

      <article class="dr-agreement__document">
        <div class="dr-agreement__document-title">
          <span>DRAGONSRITUAL CONTRIBUTOR AGREEMENT</span>
          <small>VERSION 1.0 · AUGUST 2026</small>
        </div>

        <section>
          <h2>1. Purpose and contributor access</h2>
          <p>
            This Contributor Agreement ("Agreement") governs access to private contributor areas,
            editorial systems, unpublished materials, and collaborative spaces operated under the
            DragonsRitual name ("DragonsRitual"). Access is provided so the contributor can create,
            submit, discuss, and develop original creative work for possible publication,
            collaboration, promotion, or other mutually agreed projects.
          </p>
          <p>
            Contributor access is personal. The contributor will not share login credentials,
            private links, access tokens, passwords, unpublished files, or other methods of entering
            restricted DragonsRitual systems with another person.
          </p>
        </section>

        <section>
          <h2>2. Confidential and inside information</h2>
          <p>
            "Confidential Information" means non-public information the contributor learns,
            receives, views, or accesses through DragonsRitual, including unpublished writing,
            artwork, music, videos, game builds, source code, designs, concepts, project plans,
            business plans, launch plans, editorial discussions, contributor information,
            private messages intended for the project, internal documents, private links,
            credentials, technical information, and other material that is clearly private,
            internal, unreleased, draft, confidential, or contributor-only.
          </p>
          <p>
            The contributor will keep Confidential Information inside DragonsRitual and will not,
            without permission, disclose it to outsiders; post or transmit it publicly; reproduce
            it for unrelated use; photograph or screenshot it for distribution; publish excerpts;
            or use it to compete with, impersonate, exploit, or harm DragonsRitual or another contributor.
          </p>
          <p>
            These restrictions do not apply to information that becomes publicly released by
            DragonsRitual or the rightful owner, was lawfully known to the contributor before access,
            is independently developed without using Confidential Information, or must be disclosed
            by law. If legally permitted, the contributor should give DragonsRitual reasonable notice
            before a legally compelled disclosure.
          </p>
        </section>

        <section>
          <h2>3. Contributor ownership</h2>
          <p>
            The contributor keeps ownership of original work the contributor created before joining
            DragonsRitual and of new original work the contributor creates, unless the contributor
            and DragonsRitual later sign a separate written agreement that expressly transfers ownership.
            Access to the Writer Room does not by itself transfer copyright ownership to DragonsRitual.
          </p>
        </section>

        <section>
          <h2>4. Submission, editorial review, and publication license</h2>
          <p>
            Submitting material to the DragonsRitual editorial system is a request for review, not
            automatic publication. DragonsRitual may accept, decline, return, request revisions,
            edit by mutual coordination, choose placement, schedule, feature, archive, or remove
            submitted material. The contributor should raise any requested credit, context, or
            restrictions with the editor before publication.
          </p>
          <p>
            When the contributor knowingly approves a work for publication by DragonsRitual, the
            contributor grants DragonsRitual a non-exclusive, worldwide, royalty-free license to
            publish, reproduce, display, distribute, format, excerpt for promotional purposes,
            link to, archive, and promote that accepted work through DragonsRitual websites,
            social channels, newsletters, promotional materials, and related studio channels.
            Because the license is non-exclusive, the contributor may continue using and publishing
            the contributor's work elsewhere unless a separate written agreement says otherwise.
          </p>
          <p>
            DragonsRitual will make reasonable efforts to preserve the contributor's agreed credit/byline.
            Material may be reformatted for layout, accessibility, technical compatibility, excerpts,
            previews, thumbnails, or promotion without changing the fundamental authorship of the work.
          </p>
        </section>

        <section>
          <h2>5. Rights to uploaded material</h2>
          <p>
            The contributor will submit only material the contributor owns or has permission to use.
            The contributor will not knowingly submit plagiarized writing, unauthorized copyrighted
            images, music, video, private personal information, malware, or material that the contributor
            has no right to provide. If third-party material requires attribution or a specific license,
            the contributor will identify that requirement to the editor.
          </p>
        </section>

        <section>
          <h2>6. Compensation, employment, and future projects</h2>
          <p>
            Creating a contributor account and receiving access does not by itself create employment,
            a partnership, an agency relationship, or a promise of payment. Any compensation,
            commission, revenue share, work-for-hire arrangement, ownership transfer, deadline,
            exclusivity term, or paid assignment must be separately agreed in writing before it applies.
          </p>
          <p>
            The parties may later choose to collaborate on games, publications, art, music, events,
            or other projects. Those projects may require additional project-specific terms.
          </p>
        </section>

        <section>
          <h2>7. Community and professional conduct</h2>
          <p>
            Contributor access is intended for good-faith creative collaboration. The contributor
            will not use private systems to harass other contributors, intentionally damage the service,
            obtain unauthorized access, impersonate another user, scrape private material, or interfere
            with the work of others. Editorial disagreement alone is not a violation of this Agreement.
          </p>
        </section>

        <section>
          <h2>8. Ending access</h2>
          <p>
            Either the contributor or DragonsRitual may end the contributor relationship. DragonsRitual
            may suspend or remove private access when reasonably necessary to protect the studio,
            contributors, systems, or confidential work. Ending access does not erase rights already
            granted for work that was previously published unless DragonsRitual and the contributor
            agree otherwise in writing.
          </p>
        </section>

        <section>
          <h2>9. Continuing confidentiality</h2>
          <p>
            The obligations concerning Confidential Information continue after contributor access ends
            for as long as the information remains non-public and confidential. Trade secrets, if any,
            remain protected for as long as they legally qualify as trade secrets.
          </p>
        </section>

        <section>
          <h2>10. Entire contributor-access understanding</h2>
          <p>
            This Agreement applies to contributor access and does not replace a later written agreement
            covering a specific paid assignment, ownership transfer, work-for-hire project, licensing
            deal, or other specialized collaboration. If a later signed agreement directly conflicts
            with this Agreement for a specific project, the project-specific agreement controls for
            that project.
          </p>
        </section>

        <div class="dr-agreement__legal-note">
          This contributor-access agreement is intended as a practical working agreement and is not
          a substitute for advice from an attorney. DragonsRitual may ask contributors to accept an
          updated version if the contributor program materially changes.
        </div>
      </article>

      <section class="dr-agreement__accept">
        <span class="wr-kicker">ACCEPT & ENTER</span>
        <h2>Your desk is on the other side.</h2>
        <p data-agreement-user>Checking contributor identity…</p>

        <form data-agreement-form>
          <label>
            <span>YOUR NAME</span>
            <input name="legal_name" autocomplete="name" required placeholder="Type your name" />
          </label>

          <label class="dr-agreement__check">
            <input type="checkbox" name="accept" required />
            <span>I have read and agree to the DragonsRitual Contributor Agreement, Version 1.0.</span>
          </label>

          <label class="dr-agreement__check">
            <input type="checkbox" name="confidential" required />
            <span>I understand that private and unpublished material I access through DragonsRitual is inside information and must remain confidential as described above.</span>
          </label>

          <button class="wr-primary" type="submit" data-agreement-submit>ACCEPT & ENTER WRITER ROOM</button>
        </form>

        <p class="wr-message" data-agreement-message aria-live="polite"></p>
        <button class="dr-agreement__signout" type="button" data-agreement-signout>SIGN OUT INSTEAD</button>
      </section>
    </section>
  </main>

  <script>
    import { getSupabaseBrowserClient } from '../lib/supabaseBrowser';

    const supabase = getSupabaseBrowserClient();
    const form = document.querySelector('[data-agreement-form]');
    const message = document.querySelector('[data-agreement-message]');
    const submit = document.querySelector('[data-agreement-submit]');
    const identity = document.querySelector('[data-agreement-user]');
    const say = (text, bad=false) => {
      message.textContent = text;
      message.classList.toggle('is-error', bad);
    };

    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      location.href = '/join/';
    } else {
      const user = session.user;
      const display = user.user_metadata?.display_name || user.email?.split('@')[0] || 'Contributor';
      identity.textContent = `${display} · ${user.email}`;

      const { data: profile } = await supabase
        .from('dr_creator_profiles')
        .select('contributor_agreement_version, contributor_agreement_accepted_at, agreement_legal_name')
        .eq('user_id', user.id)
        .maybeSingle();

      if (profile?.contributor_agreement_version === '1.0' && profile?.contributor_agreement_accepted_at) {
        location.href = '/writer-room/';
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submit.disabled = true;
        say('RECORDING AGREEMENT…');

        const legalName = form.legal_name.value.trim();

        const payload = {
          user_id: user.id,
          display_name: display,
          creator_type: 'writer',
          agreement_legal_name: legalName,
          contributor_agreement_version: '1.0',
          contributor_agreement_accepted_at: new Date().toISOString()
        };

        const { error } = await supabase
          .from('dr_creator_profiles')
          .upsert(payload, { onConflict: 'user_id' });

        if (error) {
          say(error.message, true);
          submit.disabled = false;
          return;
        }

        say('AGREEMENT ACCEPTED. OPENING YOUR DESK…');
        setTimeout(() => location.href = '/writer-room/', 400);
      });

      document.querySelector('[data-agreement-signout]').addEventListener('click', async () => {
        await supabase.auth.signOut();
        location.href = '/';
      });
    }
  </script>
</SiteLayout>
